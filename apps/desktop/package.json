{
  "name": "@omakase/desktop",
  "productName": "Omakase",
  "version": "0.1.0",
  "private": true,
  "description": "Omakase local learning studio desktop application",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "fetch:model": "node scripts/fetch-embedding-model.mjs",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:dmg": "bash ../../scripts/make-macos-dmg.sh",
    "publish": "electron-forge publish",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:packaged": "vitest run --config vitest.e2e.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.25",
    "@ai-sdk/openai": "4.0.25",
    "@huggingface/transformers": "3.7.2",
    "@omakase/contracts": "workspace:*",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "ai": "7.0.43",
    "better-sqlite3": "13.0.2",
    "defuddle": "0.19.2",
    "katex": "^0.18.1",
    "pdfjs-dist": "4.10.38",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router": "7.8.2",
    "unpdf": "1.8.0",
    "uuidv7": "1.2.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.0.14",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "43.2.0",
    "playwright": "1.55.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "4.1.10"
  }
}
