# Copy values into a local .env (gitignored) or your shell.
# Never commit real keys.

# Optional: force mock provider for local development/tests
OMAKASE_MOCK_PROVIDER=1
OMAKASE_TEST=1

# Optional: local AI traces (writes outside the repo by default)
# OMAKASE_AI_TRACES=1
# OMAKASE_TRACES_DIR=/absolute/path/to/traces

# Optional: Langfuse adapter seam (remote OFF unless both set intentionally)
# OMAKASE_LANGFUSE_ENABLED=1
# OMAKASE_LANGFUSE_HOST=https://cloud.langfuse.com

# Optional MCP / live evals (development machines only)
# CONTEXT7_API_KEY=
# GITHUB_PERSONAL_ACCESS_TOKEN=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
